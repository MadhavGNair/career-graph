# =============================================================================================
# CareerGraph settings. Copy to .env (`make init` does it) and edit.
# Works as-is in demo mode: no keys, no network, fake LLM, fictional user "Sam Demo".
# Every variable: what it does | allowed values | default | cost impact (where relevant).
# Never commit .env. Secrets are read only from the environment.
# =============================================================================================

# ---- Mode ------------------------------------------------------------------------------------

# Which adapters run. demo = fake LLM + fixtures, no keys, no network. live = real models,
# real job boards, GitHub and your profile in profiles/me/. | demo, live | demo
# Cost: live mode spends API tokens (capped by the budget section below).
APP_MODE=demo

# Deployment environment. production requires UI_PASSWORD. | development, production | development
APP_ENV=development

# Log verbosity. | DEBUG, INFO, WARNING, ERROR | INFO
LOG_LEVEL=INFO

# Log format. json = one JSON object per line (for files and k8s), console = readable. | json, console | json
LOG_FORMAT=json

# ---- Paths (relative to the repo root unless absolute) ---------------------------------------

# SQLite files, caches and run data. | path | data
DATA_DIR=data

# Where rendered CVs, letters, reports and eval reports go (gitignored). | path | outputs
OUTPUT_DIR=outputs

# HTTP (ETag) and embedding caches. | path | data/cache
CACHE_DIR=data/cache

# Folder holding search.yaml, criteria.yaml, profile.yaml, skills.yaml, pricing.yaml. | path | config
# Note: in demo mode, search and profile come from data/demo/ so the demo is reproducible.
CONFIG_DIR=config

# LaTeX templates. profiles/me/templates/ overrides files here. | path | templates
TEMPLATES_DIR=templates

# Database. Empty = SQLite at DATA_DIR/careergraph-<mode>.db (zero infrastructure).
# Postgres example: postgresql://careergraph:secret@localhost:5432/careergraph
# The LangGraph checkpointer and Store use the same backend. | URL or empty | (empty)
DATABASE_URL=

# ---- Models (live mode only; demo always uses the built-in fake LLM) ------------------------

# Cheap tier: extraction, match rationales, claim verification, research steps.
# Form "provider:model" (LangChain init_chat_model). | any supported model | anthropic:claude-haiku-5-5
# Cost: called once per new posting plus once per claim; keep this a small model.
CHEAP_MODEL=anthropic:claude-haiku-5-5

# Strong tier: drafting CVs and letters only. | provider:model | anthropic:claude-sonnet-5-5
# Cost: called once per approved job per revision (max MAX_REVISIONS+1 times).
STRONG_MODEL=anthropic:claude-sonnet-5-5

# Anthropic effort for the cheap tier (lower = fewer thinking tokens). Empty = model default.
# | (empty), low, medium, high | low   Cost: higher effort spends more output tokens.
CHEAP_EFFORT=low

# Anthropic effort for the strong tier. | (empty), low, medium, high | medium
STRONG_EFFORT=medium

# Hard cap on output tokens for a single LLM call. | 256-64000 | 8000
MAX_OUTPUT_TOKENS_PER_CALL=8000

# Per-call timeout in seconds. | >0 | 120
LLM_TIMEOUT_SECONDS=120

# Anthropic API key, required in live mode for anthropic:* models. | secret | (empty)
ANTHROPIC_API_KEY=

# ---- Budgets (enforced in both modes; tokens work without any price data) -------------------

# Max new postings analysed per run (older ones are skipped by content hash). | >=1 | 30
# Cost: each new posting costs one cheap-tier extraction call.
MAX_JOBS_PER_RUN=30

# Max LLM tokens (input+output) per run/thread. On breach the run halts, checkpointed and
# resumable with `make resume THREAD=...`. | >=1000 | 400000
MAX_TOKENS_PER_RUN=400000

# Max LLM tokens per calendar day (UTC) across all runs. | >=1000 | 1500000
MAX_TOKENS_PER_DAY=1500000

# Optional USD cap per run. Only enforced when config/pricing.yaml has prices. | number or empty | (empty)
MAX_USD_PER_RUN=

# Optional USD cap per day. Only enforced when config/pricing.yaml has prices. | number or empty | (empty)
MAX_USD_PER_DAY=

# Max draft->verify revisions per job before the draft is flagged for you. | 0-10 | 3
# Cost: each revision is one strong-tier call plus cheap verification calls.
MAX_REVISIONS=3

# ---- Feature switches -------------------------------------------------------------------------

# Run the company-research ReAct loop for approved jobs. | true, false | false
# Cost: up to RESEARCH_MAX_STEPS cheap-tier calls per approved job, capped by RESEARCH_MAX_TOKENS.
ENABLE_COMPANY_RESEARCH=false

# Max plan->tool->reflect steps per company. | 1-12 | 4
RESEARCH_MAX_STEPS=4

# Max tokens one company research loop may spend. | >=1000 | 20000
RESEARCH_MAX_TOKENS=20000

# Web search used by research. site = no key, reads only the company's own pages listed in
# search.yaml `companies`. tavily / brave need a key (check their current free tiers). | site, tavily, brave | site
SEARCH_PROVIDER=site

# Tavily key (SEARCH_PROVIDER=tavily). | secret | (empty)
TAVILY_API_KEY=

# Brave Search key (SEARCH_PROVIDER=brave). | secret | (empty)
BRAVE_API_KEY=

# One cheap-tier call per shortlisted job to write a short rationale. | true, false | true
ENABLE_MATCH_RATIONALE=true

# Pause for your review of drafts before rendering. false skips the second pause. | true, false | true
REQUIRE_DOCUMENT_REVIEW=true

# ---- LaTeX ------------------------------------------------------------------------------------

# PDF engine. auto = tectonic, then pdflatex, else write .tex only. | auto, tectonic, pdflatex, none | auto
LATEX_ENGINE=auto

# Compile timeout in seconds. | >=5 | 120
LATEX_TIMEOUT_SECONDS=120

# ---- Retrieval ----------------------------------------------------------------------------

# Embeddings for semantic match. auto = hashing in demo (no download), fastembed in live.
# fastembed downloads a small model once into CACHE_DIR. | auto, hashing, fastembed | auto
EMBEDDING_BACKEND=auto

# fastembed model name. | any fastembed model | BAAI/bge-small-en-v1.5
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ---- Network ------------------------------------------------------------------------------

# Optional GitHub token (raises the public API limit from 60/hour). Read-only, no scopes needed. | secret | (empty)
GITHUB_TOKEN=

# Per-request timeout in seconds. | >0 | 20
HTTP_TIMEOUT_SECONDS=20

# Max response size in bytes; larger bodies are rejected. | >=10000 | 3000000
HTTP_MAX_BYTES=3000000

# Minimum seconds between requests to the same host (politeness). | >=0 | 1.0
HTTP_MIN_INTERVAL_SECONDS=1.0

# Contact appended to the User-Agent so site owners can reach you (URL or email). | text | (empty)
HTTP_CONTACT=

# ---- Interview practice (tracker graph) --------------------------------------------------

# Questions per mock interview. Each answer costs one cheap-tier scoring call. | 1-20 | 5
MOCK_INTERVIEW_TURNS=5

# ---- UI -----------------------------------------------------------------------------------

# Streamlit bind address. Keep 127.0.0.1 unless behind auth (Docker sets 0.0.0.0). | host | 127.0.0.1
UI_HOST=127.0.0.1

# Streamlit port. | 1-65535 | 8501
UI_PORT=8501

# Password gate for the UI. Required when APP_ENV=production. | secret | (empty)
UI_PASSWORD=

# ---- Observability ------------------------------------------------------------------------

# Send traces to LangSmith. Off by default; sends prompts (with your CV) to LangSmith. | true, false | false
LANGSMITH_TRACING=false

# LangSmith key (only if LANGSMITH_TRACING=true). | secret | (empty)
LANGSMITH_API_KEY=

# LangSmith project name. | text | careergraph
LANGSMITH_PROJECT=careergraph

# ---- Demo scenario ------------------------------------------------------------------------

# Demo only: the posting id whose FIRST draft contains a fabricated claim, so you can watch
# the verify -> revise loop catch it. Empty disables. | posting id | gh-nimbus-analytics-4001
DEMO_FABRICATE_JOB=gh-nimbus-analytics-4001
